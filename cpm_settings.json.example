# CPM Configuration
# Copy this file to cpm_settings.json and fill in your values.
# NEVER commit cpm_settings.json to version control.

{
  "es_host": "https://your-cluster.es.europe-west4.gcp.elastic-cloud.com",
  "es_api_key": "YOUR_BASE64_ENCODED_API_KEY_HERE",
  "monitoring_index": ".monitoring-es-8-*",
  "cluster_registry": {
    "central-cluster": {
      "ingest_hosts": "https://es-central",
      "dc": "dc-central"
    },
    "remote-a": {
      "ingest_hosts": "https://es-remote-a",
      "dc": "dc-a"
    },
    "remote-b": {
      "ingest_hosts": "https://es-remote-b",
      "dc": "dc-b"
    }
  }
}